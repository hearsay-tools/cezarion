{
  "name": "@wjarka/cezarion",
  "version": "0.18.0",
  "description": "Local cockpit for running and tracking AI agent tasks in your repo. Uses your logged-in `claude` CLI and `gh` — zero config, zero database.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cezarion": "dist/index.js",
    "cez": "dist/index.js",
    "hsq": "dist/hsq.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./app-type": "./dist/server/app-type.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "web/dist",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "prebuild": "node scripts/sync-readme.mjs",
    "build": "tsc",
    "check:pack": "node scripts/check-pack.mjs",
    "dev": "tsx src/index.ts",
    "install-as-command": "node scripts/install-as-command.mjs --mode link",
    "install-as-command:global": "node scripts/install-as-command.mjs --mode global",
    "uninstall-as-command": "node scripts/install-as-command.mjs --mode uninstall",
    "bench:family-reconcile": "node --import tsx scripts/benchmark-family-reconcile.ts",
    "bench:run-store": "node --import tsx scripts/benchmark-run-store.ts",
    "bench:stuck-destroys": "node --import tsx scripts/benchmark-stuck-destroys.ts",
    "bench:workspace-events": "node --import tsx scripts/benchmark-workspace-events.ts",
    "server-install": "tsx src/index.ts server-install",
    "server-deploy": "tsx src/index.ts server-deploy",
    "server-uninstall": "tsx src/index.ts server-uninstall",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "node --import ../../scripts/test-home-env.mjs --import tsx --test test/unit/*.test.ts",
    "test:package": "node ../../scripts/test-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:package": "tsc --noEmit -p tsconfig.package.json",
    "postbuild": "node scripts/inline-contract.mjs",
    "bench:project-probes": "node --import tsx scripts/benchmark-project-probes.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@hono/node-server": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.6.0",
    "smol-toml": "^1.7.0",
    "ws": "^8.21.1",
    "yaml": "^2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.8",
    "@babel/types": "^8.0.8",
    "@open-mercato/cezar-api-client": "^0.18.0",
    "@open-mercato/cezar-contract": "^0.18.0",
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "fast-check": "^4.10.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hearsay-tools/squawk",
    "directory": "packages/cezar"
  },
  "publishConfig": {
    "access": "public"
  }
}
