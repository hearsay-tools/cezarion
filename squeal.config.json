{
  "interrupt": {
    "onRegression": true
  },
  "stop": {
    "blockOnKnownFailures": false,
    "requireFullSuite": false,
    "requireSlowSuite": false,
    "waitMs": 0
  },
  "baseline": {
    "onStart": "lookup-only"
  },
  "inputs": {
    "packages/cezar/test/e2e/*.test.ts": [
      "packages/cezar/dist/**",
      "packages/cezar/web/dist/**",
      "packages/cezar/scripts/**",
      "packages/cezar/package.json",
      "alias-cezarion/**",
      "pnpm-lock.yaml"
    ],
    "packages/web/e2e/*.e2e.ts": [
      "packages/cezar/dist/**",
      "packages/cezar/web/dist/**",
      ".ai/scripts/test-env-up.sh",
      ".ai/browsers/agent-browser.md",
      "packages/web/e2e/**",
      "pnpm-lock.yaml"
    ]
  },
  "env": {
    "allowlist": []
  },
  "runner": {
    "tierSize": 4,
    "timeoutMs": 600000
  },
  "nodeTest": [
    {
      "name": "test:unit",
      "cwd": "packages/cezar",
      "argv": [
        "--import",
        "../../scripts/test-git-env.mjs",
        "--import",
        "tsx"
      ],
      "include": ["test/unit/*.test.ts"]
    },
    {
      "name": "root:test:unit",
      "argv": ["--import", "./scripts/test-git-env.mjs"],
      "include": [".github/scripts/*.test.cjs", "scripts/*.test.mjs"]
    },
    {
      "name": "test:package",
      "cwd": "packages/cezar",
      "argv": [
        "--import",
        "../../scripts/test-git-env.mjs",
        "--import",
        "tsx"
      ],
      "include": ["test/e2e/*.test.ts"],
      "slow": true
    }
  ],
  "slow": {
    "include": ["packages/web/e2e/*.e2e.ts"],
    "maxWorkers": 1,
    "maxParallel": 1
  },
  "daemon": {
    "idleExitMinutes": 60
  },
  "store": {
    "retentionDays": 7,
    "maxSizeMb": null
  }
}
