+            expect(restricted!.filter(row => row.url.includes('prompt_async')).every(row => row.body.tools === undefined)).toBe(true);
+          }
+        } finally { rmSync(dir, { recursive: true, force: true }); }
+      }, 45000);
+    }
+  }
