# cezar environment variables — copy to `.env` and adjust. Every var is optional;
# the defaults give a zero-config local cockpit. cezar reads these from the process
# environment (it does not auto-load `.env` — export them, or use your shell/dotenv).

# ---- deployment mode --------------------------------------------------------
# Local (default) exposes host-only conveniences: "open in editor/Finder/terminal",
# worktree-path handoff, the launch bookmarklet. Set to 1 for VPS / hosted mode to
# hide those host-machine affordances (the cockpit is being viewed over the network).
# The Add project browser is always confined to CEZ_BROWSE_ROOT (default `~/`); set that
# root narrowly for a hosted cockpit if the remote viewer should not enumerate the whole home.
# CEZ_REMOTE=1

# ---- cez task / discover (terminal / bot client) --------------------------------------
# Cockpit origin `cez task` and operator `cez discover` talk to. Unset (default): it probes 127.0.0.1:4321-4370
# for the cockpit whose project registry holds this checkout. Set it to reach a
# specific cockpit, e.g. a hosted CEZ_REMOTE one; no auth header is added.
# Parent-session discovery instead uses its authenticated delegation controller.
# CEZ_URL=http://127.0.0.1:4321
# `cez automation` reads it too, but only for a human at a shell: inside a task it uses the
# injected CEZ_COCKPIT_URL / CEZ_PROJECT_ID and never probes.

# ---- dev launcher (scripts/dev.mjs) -----------------------------------------
# API port the cockpit server listens on and Vite proxies /api to. `npm run dev`
# probes for a free port and sets this automatically; set it only to pin a port.
# CEZ_API_PORT=4321

# ---- agent CLIs -------------------------------------------------------------
# Override the discovered path to each backend CLI (defaults: found on PATH).
# CEZ_CLAUDE_BIN=/usr/local/bin/claude
# CEZ_CODEX_BIN=/usr/local/bin/codex
# CEZ_OPENCODE_BIN=/usr/local/bin/opencode
# CEZ_PI_BIN=/usr/local/bin/pi
# OMP (Oh My Pi) CLI is named `omp`; this overrides its path.
# CEZ_OMP_BIN=/usr/local/bin/omp
# Cursor CLI is named `agent`; this overrides its path. Qualified builds use
# marketplace-enabled print turns for new sessions; legacy sessions retain ACP.
# CEZ_CURSOR_BIN=/usr/local/bin/agent

# The agents' OWN home variables (not cezar's) are honoured where the vendor documents one:
# setting one here moves that agent's DEFAULT account — the one cezar discovers. A SECOND login of
# the same CLI is deliberately NOT configured through the environment, because a process-wide
# variable cannot differ per project: add it in Settings → Agent accounts and pick it per project,
# and the two accounts can then be used side by side.
# CLAUDE_CONFIG_DIR=~/.claude
# CODEX_HOME=~/.codex
# PI_CODING_AGENT_DIR=~/.pi/agent

# Claude denies tools that require approval instead of interrupting a headless run. Set to 1
# to opt back into Claude's interactive approval UI (`acceptEdits`).
# CEZ_APPROVAL_GATE=1
#
# Override the Claude agent-run permission flag. Unset keeps the path above (`dontAsk`, or
# `acceptEdits` when CEZ_APPROVAL_GATE=1). `bypass` drops `--permission-mode` and passes
# `--dangerously-skip-permissions` instead. Provider verification (`claude auth status`) is
# never given these flags.
# CEZ_CLAUDE_PERMISSION_MODE=dontAsk
# CEZ_CLAUDE_PERMISSION_MODE=acceptEdits
# CEZ_CLAUDE_PERMISSION_MODE=bypass
#
# Optional. When set, agent runs also pass `--setting-sources <value>` (e.g. user,project,local).
# Unset or empty: the flag is omitted. Provider verification is never given this flag.
# CEZ_CLAUDE_SETTING_SOURCES=user,project,local

# Codex inherits enterprise-managed permissions. Confirmed unmanaged sessions keep full
# access (including containers without UID maps). If requirements cannot be read, Codex
# defaults apply. Set to 0 for network-blocked workspace-write on unmanaged sessions;
# managed filesystem rules are preserved. No turn starts unless Codex confirms network
# restriction, so a managed profile with network enabled reports a conflict instead.
# CEZ_CODEX_NETWORK=0
# Codex app-server reasoning summary: auto (default), concise, detailed, or none.
# Unrecognized values fall back to auto.
# CEZ_CODEX_REASONING=auto

# Every task's agent gets its own temp directory (TMPDIR/TEMP/TMP) at `.ai/cezar/t/<task-id8>`
# (`.ai/cezar/tmp/<task-id>` before hearsay-tools/cezarion#1022), created and write-probed before
# the agent spawns. Scratch survives session close, Continue, and restart while the task is live;
# terminal completion or history deletion reaps it (#515). Concurrent tasks do not share scratch.
# A checkout deep enough that this path would leave no room for a unix socket under it (at most 58
# bytes, so Chromium's `org.chromium.Chromium.XXXXXX/SingletonSocket` and tsx's IPC socket still
# fit the kernel's path limit) resolves the
# directory to a short `cez-agent-…` directory under the system temp dir instead. Its location is
# recorded so changing the host temp environment cannot move live scratch. Set 0 to hand
# agents the host TMPDIR verbatim again — the pre-spawn check turns off with it.
# CEZ_AGENT_TMPDIR=0

# ---- project folders --------------------------------------------------------
# Zero-config defaults for the two independent Add project folders. Saved values in Global
# Settings → Projects override these defaults. The browse root must already exist; missing
# checkout folders are created recursively when saved and when a clone or a new project starts.
# CEZ_BROWSE_ROOT=~/
# CEZ_PROJECTS_DIR=~/cezar/projects

# ---- local state and startup UI ---------------------------------------------
# Override cezar's global state directory (default: `~/.cezar`). Useful for isolated test or
# container installs; an empty value deliberately falls back to the default. This home holds
# `config.json` — the per-user workspace config (parallel cap, memory ceiling, project roots)
# and the project registry every repo cezar boots in registers itself into — so two cockpits
# started with different CEZ_HOME values serve disjoint sets of projects. Missing, corrupt or
# read-only: cezar falls back to defaults and keeps running.
# CEZ_HOME=/path/to/cezar-state

# Prepare every other registered project in the background once the cockpit listens (#667):
# its run store opens, its worktrees are swept and the runs a restart interrupted resume, so the
# first click on that project does not wait for it. One project at a time, most recently opened
# first; a project another live cockpit serves is skipped. On by default; set to 0 to prepare
# each project only when it is first opened.
# CEZ_PROJECT_WARMUP=0
# New Task defaults. Exact 0/1 only; workspace Settings overrides these seeds.
# CEZ_AUTONOMOUS_DEFAULT=0
# CEZ_WORKTREE_DEFAULT=1

# Dangerous escape hatch for any run executing in the repository root, including an
# explicit worktree opt-out, non-Git degradation, or a continuation whose worktree
# cannot be restored. Only the exact value 1 bypasses the repository-root lease.
# Concurrent agents may overwrite each other's files or Git state; isolated worktrees
# are unaffected. Off by default.
# CEZ_DISABLE_REPO_LOCK=1

# Opt into a launch-project-only cockpit. Only the exact value 1 enables this mode
# (`true`, `yes`, and every other value leave the default multi-project workspace on).
# While enabled, cezar exposes only the repo it was launched in and refuses project add,
# edit, checkout, browse, and remove operations. Registry rows are retained: unset the
# variable and restart to restore the full workspace without migration or data loss.
# CEZ_SINGLE_PROJECT=1

# Hide token counts or backend-reported cost independently throughout the browser
# cockpit. The legacy CEZ_HIDE_TOKEN_METRICS master switch hides both. Only the exact
# value 1 enables any presentation-only mode; telemetry and API payloads are preserved.
# Restart cezar after changing these flags.
# CEZ_HIDE_TOKEN_USAGE=1
# CEZ_HIDE_COST=1
# CEZ_HIDE_TOKEN_METRICS=1

# ---- Removed generated inbox (hearsay-tools/cezarion#1543) --------------------
# CEZ_FOLLOWUPS no longer enables generation. Remove it from your launch environment.
# CEZ_TODOS_FILE is no longer a usable agent output; inherited values are shadowed empty.
# Existing .ai/cezar/todos.json files stay on disk. Copy the file to export it and use
# New task for selected work. CEZ_HANDOFF_FILE and per-task Notes continue to work.

# ---- Automations (GitHub polls and schedules) -----------------------------------
# Off by default. Set to 1 to turn automations on: the Automations view appears in the cockpit,
# its endpoints answer, and cezar runs each enabled automation while it is running. Two kinds
# exist: a GitHub automation polls GitHub on its interval; a schedule (every day, weekdays, one
# weekday a week, every N hours, in the server's time zone) fires on the clock and needs no
# GitHub remote. Only the exact value 1 enables it (`true`, `yes`, and every other value leave
# it off), and it is read at boot — set it and restart cezar. Left off, nothing polls GitHub,
# nothing fires and no task is launched. Foreground GitHub lists still refresh every 60 seconds.
# Automation definitions, receipts and their frozen
# high-watermarks are kept either way, so this is safe to flip back and forth.
# CEZ_AUTOMATIONS=1
# The browser suite exercises the default-off route. The schedule journey boots its own fixture
# server with this flag; the GitHub journey runs on the shared test environment and still needs
# one booted with it: `npm run test:e2e -- --server-env=CEZ_AUTOMATIONS=1`.

# ---- voice mode (experimental) --------------------------------------------------
# Off by default. Set to 1 to turn voice mode on: the Cmd/Ctrl+K palette understands a sentence
# ("open the next finished task", "answer yes") and the server asks Jev (TypeSafe) to turn it into
# one action the cockpit shows and runs. Only the exact value 1 enables it (`true`, `yes`, and
# every other value leave it off), and it is read at boot - set it and restart cezar. Left off, the
# voice endpoints answer `409`, capabilities.voice is false and the palette renders exactly as
# before; nothing else changes.
# CEZ_VOICE=1
# The key for Jev. Voice mode needs it, unless CEZ_DRY_RUN=1, which swaps in a fake engine and
# calls no one. Only the server reads it: it is never sent to the browser, never logged and never
# put in an error message.
# TYPESAFE_API_KEY=
# The browser suite boots its own fixture server with the flag:
# `npm run test:e2e -- --server-env=CEZ_VOICE=1`.

# ---- live preview (experimental) ------------------------------------------------
# Off by default. Set to 1 to turn live preview on: agents get the cezar_preview_serve tool to
# register a dev server, and the cockpit can open it in a headless Chromium that runs on the
# host, docked next to the task. cezar first starts a registered command when you press Run and
# open. The adjacent cezar_preview_stop tool stops/restarts only this task's Cezar-started
# servers; restart reuses unchanged approval. Changed command/cwd/path needs Run and open again.
# Only the exact value 1 enables it (`true`, `yes`, and every other value leave it off),
# and it is read at boot — set it and restart cezar. Left off, the tool is not listed, its route
# answers nothing, the preview WebSocket refuses and capabilities.preview is false.
# CEZ_PREVIEW=1
# A dev server cezar starts gets the same least-privilege env agents get, minus every backend
# credential and GITHUB_TOKEN: the command is the agent's and runs outside its sandbox. Name a
# var it needs in CEZ_ENV_PASSTHROUGH (comma-separated; it reaches agents too), or set
# CEZ_AGENT_ENV_FULL=1 to hand agents and dev servers the full host environment.
# CEZ_ENV_PASSTHROUGH=DATABASE_URL
# Preview lets Chromium discover host graphics and fall back to software. No driver
# or backend is forced. Linux may need a display in the cockpit environment.
# The only way to launch the preview's Chromium with --no-sandbox. Never added automatically,
# not even for root or inside a container. Set it only where Chromium's sandbox cannot start
# (the pane shows the sandbox failure and points here), and only for pages you trust: a page
# that escapes the renderer then runs with your user's rights. Exact value 1 only; read at boot.
# CEZ_PREVIEW_NO_SANDBOX=1

# ---- task auto-naming ---------------------------------------------------------
# Short LLM-generated task titles (spec 2026-07-17-task-auto-naming). On by default.
# CEZ_TITLE_UPDATES=0 turns off the live per-turn title refresh (the Settings → Agents
# toggle, when set, wins over this env default). CEZ_AUTONAME=0 is the kill-switch for
# ALL LLM naming — creation-time and live — leaving only the heuristic titles. Under
# CEZ_DRY_RUN=1 naming is off by default (mock titles would clobber honest heuristics);
# CEZ_AUTONAME=1 forces it there — used by the test suite.
# CEZ_TITLE_UPDATES=0
# CEZ_AUTONAME=0

# ---- review gate -------------------------------------------------------------
# Optional diff-first review gate (#489). OFF by default: a successful run with
# changes settles straight to `done`, leaving the diff in the worktree. Set
# CEZ_REVIEW_GATE=1 to make a changed non-autonomous run park at `review` for a
# human to Accept / Send back / open a Draft PR. Only the exact string "1"
# enables it ("true"/"yes" are treated as off). The Settings → Agents toggle,
# when set, wins over this env default. Autonomous runs ALWAYS skip the gate.
# CEZ_REVIEW_GATE=1

# ---- periodic autosave -------------------------------------------------------
# Off by default. Set to 1 to re-enable the janitor-style "cezar autosave" commit every 90 s
# in each task worktree (spec 006). Left off, a task branch carries only the agent's own
# commits — plus the turn-end and pre-PR flushes, which always run so the branch still ends
# holding the finished state and the diff/review/PR views stay complete. Those flushes commit
# as `cezar autosave (turn end|run finalize|pre-PR)`; only `(periodic)` is this flag's timer.
# The turn-end/run-finalize flushes and this timer commit only while HEAD is the task's own
# `cez/<id8>` branch: on a branch the agent checked out (or a detached HEAD) they leave the
# work uncommitted, and the turn-end/run-finalize flush says so in the handoff's
# `## Autosave (cezar)` section (created before `## Progress log` on the first report, so the
# agent's own Progress log stays clean). A turn-end/run-finalize commit is reported there too,
# with the `git reset --soft` command that folds it back. The timer's commits are reported
# there as one line per run of consecutive periodic commits (count, first and latest sha),
# never as a cockpit note. The pre-PR flush is unchanged: it commits on whatever branch HEAD is.
# CEZ_AUTOSAVE=1

# ---- GitHub -----------------------------------------------------------------
# Used for the GitHub tab / PR actions. The `gh` CLI's own auth is preferred; set
# this only if you drive git/gh through a token instead.
# GITHUB_TOKEN=ghp_xxx

# ---- cockpit bundle (build time) --------------------------------------------
# Where the cockpit's JS should look for the API. Empty (the default) means "the origin that
# served this page", and that is right in BOTH normal cases: the bundled cockpit is served by the
# CLI itself, and `npm run dev` proxies `/api` (including the `/api/v1/ws` upgrade) from the Vite
# dev server to the local service — so a relative path already reaches localhost either way, and
# setting this in development would only bypass the proxy.
# Set it only when the bundle is deployed apart from the service it talks to. A deployment that
# must be configured without a rebuild can instead put `<meta name="cez-api-base" content="…">`
# in the served HTML, which wins over this.
# VITE_CEZ_API_BASE=http://localhost:4321

# Build-time only. The cockpit e2e suite sets this when it builds the bundle it drives
# (`.ai/scripts/test-env-up.sh`). It pins `useNow` and every `refetchInterval` so a wait
# cannot span a 30s tick or a 4s poll. Leave unset for production builds.
# VITE_CEZ_E2E=1

# ---- testing / internal -----------------------------------------------------
# Run all five agent backends against bundled mock CLIs (no real model calls).
# Explicit CEZ_*_BIN overrides still win; used by the test suite.
# CEZ_DRY_RUN=1
# Test-only launcher guard override, exact 1. Set only around tests that mock child_process;
# otherwise inject the launcher seam. Unset, tests refuse real launcher spawns.
# CEZ_ALLOW_TEST_SPAWN=1

# Lock model selection to the defaults in native Claude/Codex/OpenCode settings.
# Existing `.ai/cezar/config.json` model presets are preserved but ignored while locked.
# `"modelsLocked": true` in global `~/.cezar/config.json` or a repository's
# `.ai/cezar/config.json` enables the same policy.
# Exact `1` also delegates provider authentication/enablement to the native
# agents: Cezar skips its credential probes and provider-disable preferences,
# while Claude/Codex/OpenCode runner selection remains available.
# CEZ_AGENT_MODELS_LOCKED=1
# CEZ_MOCK_ARGS_FILE=/tmp/cez-mock-args.json
# Offline mocks only (hearsay-tools/cezarion#784): a mock preloaded with
# NODE_OPTIONS=--import=<packages/cezar/scripts/mock-env-record.mjs URL> writes the values of the
# comma-separated CEZ_MOCK_ENV_RECORD_NAMES, as its own process sees them, to CEZ_MOCK_ENV_RECORD.
# Harness parity uses it to show a per-session variable reached each runner's native process.
# CEZ_MOCK_ENV_RECORD=/tmp/cez-mock-env.json
# CEZ_MOCK_ENV_RECORD_NAMES=CEZ_PREVIEW_CDP_URL
# Offline OMP mock only: simulate autoResume restoring a conversation at startup (default off).
# CEZ_MOCK_OMP_AUTO_RESUME=1
# Offline OpenCode mock only: the first N `opencode serve` starts exit before listening
# (default 0, off). Starts are counted in CEZ_MOCK_OPENCODE_SERVE_FAIL_FILE (default: beside
# CEZ_MOCK_ARGS_FILE, else a per-cwd file in the OS temp dir). The count is never reset:
# delete that file to make the next N starts fail again.
# CEZ_MOCK_OPENCODE_SERVE_FAIL_STARTS=1
# CEZ_MOCK_OPENCODE_SERVE_FAIL_FILE=/tmp/cez-mock-opencode-serve-starts
# How far out the mock CLI's `mock:limit` reply puts its usage-limit reset (seconds, default 60),
# so a CEZ_DRY_RUN=1 session can exercise auto-resume without waiting for a real window.
# CEZ_MOCK_LIMIT_RESET_SECONDS=60
# Offline native mocks only: absolute path to a test-fixture-owned failure control JSON.
# Unset (default), mocks keep their ordinary behavior and scheduling. A configured missing or
# malformed control fails clearly. `gated-once` holds one provider failure until released;
# `persistent` selects an opening prompt and failure kind until lifted. State is shared by
# matching runs across mock subprocess restarts, and removed with the fixture. Test helpers
# create this file and its sibling markers; no user configuration is needed.
# CEZ_MOCK_FAILURE_CONTROL=/tmp/cez-fixture/native-failure-control.json
# Offline native mocks only: absolute path to a test-fixture-owned delivery control JSON.
# Unset (default), mocks keep their ordinary behavior and scheduling. A configured missing or
# malformed control fails clearly; a kind a mock's wire cannot carry fails at the first input
# it matches. `reject` refuses a matching input once (or until lifted with `persistent`),
# `hold-ack` holds its acknowledgement and `hold-response` its turn content until released.
# Test helpers create this file and its sibling markers; no user configuration is needed.
# CEZ_MOCK_DELIVERY_CONTROL=/tmp/cez-fixture/native-delivery-control.json
# Offline Cursor print mock only: sleep this many ms before every turn's init frame
# (default 0, off). Cursor print spawns one process per turn, so this reproduces a loaded
# host's per-turn startup cost in tests (hearsay-tools/cezarion#1125).
# CEZ_MOCK_CURSOR_SPAWN_DELAY_MS=400
# Offline Claude mock only: how long `mock:steer-tool` holds its tool call open for steered
# input (ms, default 600). CEZ_MOCK_STEER_LINES=<n> holds it instead until n steered lines
# arrive (15 s deadline), so a loaded host cannot end the turn first (hearsay-tools/cezarion#1280).
# CEZ_MOCK_STEER_MS=600
# Offline Claude mock only: `0` stops the first turn from appending its trace line to notes.md
# in the cwd (default: it appends). A clean task worktree gives a session's turn-end and finalize
# autosaves nothing to commit; the worker-wait test fixture sets it (hearsay-tools/cezarion#1665).
# CEZ_MOCK_NOTES=0
# CEZ_MOCK_STEER_LINES=1
# Offline mocks only: how every native mock answers Cezar's no-wait nudge
# (hearsay-tools/cezarion#1234). Unset (the default), a session with cezar tools calls
# cezar_ask with a card and one without them ends with the ask line. `plain` answers in plain
# text, so the next turn end reaches the no-wait fallback.
# CEZ_MOCK_NUDGE_REPLY=plain
# Offline mocks only: the mock prompt that answers Cezar's completion refusal nudge
# (hearsay-tools/cezarion#1301). Unset (the default), the refusal gets the mocks' ordinary reply.
# `mock:ack-only` makes every native mock acknowledge the refusal on its own wire and open no turn
# until more input arrives, so the nudge's reply bound is reached.
# CEZ_MOCK_COMPLETION_REPLY=mock:ack-only
# The following are set by cezar for child agent processes; you should not set them:
#   CEZ_TASK_ID, CEZ_HANDOFF_FILE, CEZ_TODOS_FILE
#   CEZ_COCKPIT_URL, CEZ_PROJECT_ID — the origin the cockpit BOUND and this run's project id,
#   set once the server listens (hearsay-tools/cezarion#774). `cez automation` calls that address
#   and never probes ports; a headless `cez run` sets neither, so the CLI answers exit 2.
#   CEZ_PREVIEW_CDP_URL — with CEZ_PREVIEW=1 and a cockpit, the ws:// address of this session's
#   CDP proxy to the task's preview browser (hearsay-tools/cezarion#784). `agent-browser --cdp
#   "$CEZ_PREVIEW_CDP_URL" --pin-tab` drives the page the owner watches. The token in it ends with
#   the session; an inherited copy is always stripped.
#   CEZ_PROJECT_ROOT — the project root (main checkout); set for worktreeSetup commands only (#917).
#   CEZ_AUTOSAVE_OWNER — a fresh value per autosave Git command; marks Git's descendants so
#   unrelated processes in the worktree never hold autosave cleanup (hearsay-tools/cezarion#958).
#   CEZ_ARTIFACTS_DIR — task-owned snapshot directory for `cez artifact publish`.
#   Set on fresh and resumed sessions; empty when storage is unavailable.
#   No user setup needed. Limits: 10 MiB/file, 64 publications / 64 MiB per task.
#   CEZ_DELEGATION_URL, CEZ_DELEGATION_TOKEN — generated per-session delegation
#   endpoint/credential, never user-authored. Inherited copies are always stripped
#   from child agent environments, including passthrough and full-env mode.

# Owned isolated workers: off by default. One loopback listener in this controller process.
# When disabled, terminal cleanup checkpoints do not trigger conversation/wait history reconciliation.
# Explicit lifecycle recovery and cleanup termination safeguards still run.
# Session credentials and instructions are generated automatically for cockpit and headless runs.
# Per parent: at most 32 outstanding workers (accepted, live, or not yet verifiably destroyed)
# and 1,024 creations. A verified destroy frees a slot; incomplete cleanup keeps it. These are
# fixed resource and runaway bounds, not a spending budget. 32 undelivered steering messages per worker.
# CEZ_DELEGATION=1
# Internal, generated per session; do NOT author these or put a token in argv/config/prompts/logs.
# CEZ_DELEGATION_URL is the controller's assigned http://127.0.0.1:<port>/api/v1/delegation endpoint.
# CEZ_DELEGATION_TOKEN is an ephemeral bearer credential, rotated on Continue/restart and revoked on close.
# CEZ_DELEGATION_URL=<generated>
# CEZ_DELEGATION_TOKEN=<generated>

# Generated delegation credentials are always redacted, including with CEZ_REDACT_SECRETS=0.

# Internal CI-tool session wiring (issued by cezar, never configure manually).
# Memory-only capability and private local IPC address. Forwarded only for the
# owning agent session; revoked on replacement/stop/disposal. No TCP listener.
# CEZ_TOOL_TOKEN=
# CEZ_TOOL_SOCKET=
# Offline harness-test plumbing only: fixture PR input and adapter result path.
# Neither is model-facing or read by the production CI adapter/controller.
# CEZ_MOCK_CI_PR=
# CEZ_MOCK_CI_RESULT=

# Automatically archive settled task families after all associated PRs merge. Off by default.
# Saved project and global Tasks settings override this exact-1 environment default.
# CEZ_ARCHIVE_ON_MERGE=1
