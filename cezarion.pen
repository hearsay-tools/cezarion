                      "name": "Dot interpretation and accessibility",
                      "fill": "$text-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Dots remain filled while pulsing; motion is shown statically here. With reduced motion, keep them still. Tooltip and accessible text announce the exact state when colors are shared. The dot must match the task-details status, not the PR/issue badge or trailing unread dot.",
                      "lineHeight": 1.5,
                      "fontFamily": "$cezarion-font-ui",
                      "fontSize": 11,
                      "fontWeight": "normal"
