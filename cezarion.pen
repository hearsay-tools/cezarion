                  "fontFamily": "$cezarion-font-ui",
                  "fontSize": 11,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Akkvt",
                  "name": "Task status rules",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Running / monitoring / review: purple pulse. Needs you: amber pulse. Done: green. Failed: red. Queued / cancelled: neutral. Scheduled retry: amber, still. Waiting on workers: purple, still.",
                  "lineHeight": 1.6,
                  "fontFamily": "$cezarion-font-ui",
                  "fontSize": 11,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "f5eSsw",
                  "name": "Reference precedence",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "One chip: PR first, otherwise issue. Keep a different issue number in the title. Conflict takes over the chip; the underlying PR status remains in its detail panel.",
                  "lineHeight": 1.6,
                  "fontFamily": "$cezarion-font-ui",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "id": "y7a3aB",
          "name": "Responsive behavior",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Proposed two-line row keeps the title readable at narrow widths. Task and tracker are separate targets. Desktop hover/focus reveals tracker details; touch opens the tracker directly. Preserve queue position; hide age when a reference is present. Pulse is a runtime behavior, shown statically here.",
          "lineHeight": 1.6,
          "fontFamily": "$cezarion-font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    },
