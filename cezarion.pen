          "type": "text",
          "id": "SlEp9",
          "name": "Responsive behavior",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Filled task dots align with the first title line. The second row is for PR/issue badges only. Status names are available through tooltips and accessible descriptions. Worker indentation is 20px. Pinned tasks retain an accent pin; unpinned tasks expose Pin on hover/focus or in the task menu.",
          "lineHeight": 1.6,
          "fontFamily": "$cezarion-font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    },
