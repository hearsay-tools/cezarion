              "name": "Density title",
              "fill": "$text-primary",
              "content": "01 / Density changes spacing, not type",
              "fontFamily": "$cezarion-font-ui",
              "fontSize": 22,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "d47alo",
              "name": "Density facts",
              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Comfortable: 4px/unit   →   Compact: 3.5px/unit (−12.5%)   →   Compact for real: 3px/unit (−25%). Numeric spacing-based padding, gaps and control heights tighten; fixed pixel values do not automatically scale.",
              "lineHeight": 1.6,
