                      "type": "text",
                      "id": "n6wLo",
                      "name": "Dot interpretation and accessibility",
                      "fill": "$text-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Dots remain filled while pulsing; motion is shown statically here. With reduced motion, keep them still. Tooltip and accessible text announce the exact state when colors are shared. The dot must match the task-details status, not the PR/issue badge or trailing unread dot.",
                      "lineHeight": 1.5,
                      "fontFamily": "$cezarion-font-ui",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "s0pfi",
                  "name": "Reference precedence",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The badge row contains the linked PR and issue numbers. Use distinct PR/issue glyphs; show both when both exist. Tracker status stays separate from the task attention dot.",
                  "lineHeight": 1.6,
                  "fontFamily": "$cezarion-font-ui",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "id": "E06RIG",
          "name": "Responsive behavior",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Filled task dots align with the first title line. The second row is for PR/issue badges only. Status names are available through tooltips and accessible descriptions. Worker indentation is 20px. Pinned tasks retain an accent pin; unpinned tasks expose Pin on hover/focus or in the task menu.",
          "lineHeight": 1.6,
          "fontFamily": "$cezarion-font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    },
