          "type": "text",
          "id": "fIexR",
          "name": "Responsive rendering",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Tokens define both themes. Preserve type size and minimum touch targets when changing density. Full-height canvas screens expose all content; the app scrolls where needed. Shared components are the source for repeated UI.",
          "lineHeight": 1.5,
          "fontFamily": "$cezarion-font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        }
