                  "id": "AfLEv",
                  "name": "Reference precedence",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The badge row contains the linked PR and issue numbers. Use distinct PR/issue glyphs; show both when both exist. Tracker status stays separate from the task attention dot.",
                  "lineHeight": 1.6,
                  "fontFamily": "$cezarion-font-ui",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
