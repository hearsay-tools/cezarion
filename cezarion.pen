          "type": "text",
          "id": "vIduP",
          "name": "Runtime behavior",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Respect capability flags, provider authentication, allowed merge methods and server validation. Never infer merge readiness from passing checks alone. Use runner-provided resume commands. Keep drafts and inline errors when an operation fails.",
          "lineHeight": 1.5,
          "fontFamily": "$cezarion-font-ui",
          "fontSize": 13,
          "fontWeight": "normal"
        },
